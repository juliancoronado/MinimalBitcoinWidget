<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_preview_background_light"
    android:orientation="vertical">

    <!-- Top Metrics Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp">

        <!-- Header: Icon / USD ・ 7D -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/bitcoin_icon_description"
                android:src="@drawable/rounded_currency_bitcoin_24"
                android:tint="#535F70"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:fontFamily="@font/google_sans_flex_rounded"
                android:text="/ USD"
                android:textColor="#535F70"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex_rounded"
                android:text=" ・ 7D"
                android:textColor="#535F70"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- PriceValue -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex_rounded"
                android:text="$"
                android:textColor="#191C20"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/google_sans_flex_rounded"
                android:text="52,849.10"
                android:textColor="#191C20"
                android:textSize="22sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- PriceChange Pill Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_preview_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@string/trending_up_icon_description"
                android:src="@drawable/rounded_trending_up_24"
                android:tint="@color/widget_dynamic_light_on_primary_container"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/google_sans_flex_rounded"
                android:text="2.45%"
                android:textColor="@color/widget_dynamic_light_on_primary_container"
                android:textSize="11.5sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>

    <!-- Edge-to-Edge Sparkline Graph -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/chart_data_icon_description"
        android:scaleType="fitCenter"
        android:src="@drawable/chart_preview_sparkline" />

</LinearLayout>
